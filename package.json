{
  "name": "ecwid-product-git-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirror Ecwid product catalogs into git snapshots and append-only product event branches.",
  "license": "MIT",
  "bin": {
    "ecwid-product-git-watch": "src/cli.ts"
  },
  "scripts": {
    "sync": "bun run src/sync-store-branches.ts --config config/ecwid-stores.json --due-only",
    "events:commit": "bun run src/commit-event-branches.ts --config config/ecwid-stores.json",
    "events:commit:dry": "bun run src/commit-event-branches.ts --config config/ecwid-stores.json --no-push",
    "test": "bun test",
    "check": "tsc --noEmit",
    "web:check": "tsc -p web/tsconfig.json --noEmit",
    "web:dev": "vite --config web/vite.config.ts --host 0.0.0.0",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --host 0.0.0.0",
    "sync:force": "bun run src/sync-store-branches.ts --config config/ecwid-stores.json --force",
    "sync:legacy": "bun run src/cli.ts sync --config config/ecwid-stores.json",
    "sync:dry": "bun run src/sync-store-branches.ts --config config/ecwid-stores.json --due-only --no-push"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "libsodium-wrappers-sumo": "^0.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
