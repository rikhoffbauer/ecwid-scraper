het product</h2>\r\n<ul data-start=\"966\" data-end=\"1068\">\r\n<li data-start=\"966\" data-end=\"984\">\r\n<p data-start=\"968\" data-end=\"984\">In nette staat</p>\r\n</li>\r\n<li data-start=\"985\" data-end=\"1025\">\r\n<p data-start=\"987\" data-end=\"1025\">Volledig getest en technisch in orde</p>\r\n</li>\r\n<li data-start=\"1026\" data-end=\"1068\">\r\n<p data-start=\"1028\" data-end=\"1068\">Normale lichte gebruikssporen mogelijk</p>\r\n</li>\r\n</ul>\r\n<hr data-start=\"1070\" data-end=\"1073\">\r\n<h2 data-start=\"1075\" data-end=\"1086\">Levering</h2>\r\n<p> </p>\r\n<ul data-start=\"1088\" data-end=\"1179\">\r\n<li data-start=\"1088\" data-end=\"1112\">\r\n<p data-start=\"1090\" data-end=\"1112\">Canon EOS 4000D body</p>\r\n</li>\r\n<li data-start=\"1113\" data-end=\"1132\">\r\n<p data-start=\"1115\" data-end=\"1132\">18-55mm kitlens</p>\r\n</li>\r\n<li data-start=\"1133\" data-end=\"1144\">\r\n<p data-start=\"1135\" data-end=\"1144\">Filters</p>\r\n</li>\r\n<li data-start=\"1145\" data-end=\"1158\">\r\n<p data-start=\"1147\" data-end=\"1158\">Cameratas</p>\r\n</li>\r\n<li data-start=\"1159\" data-end=\"1167\">\r\n<p data-start=\"1161\" data-end=\"1167\">Accu</p>\r\n</li>\r\n<li data-start=\"1168\" data-end=\"1179\">\r\n<p data-start=\"1170\" data-end=\"1179\">Oplader</p>\r\n</li>\r\n</ul>",
