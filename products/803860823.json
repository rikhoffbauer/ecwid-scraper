\r\n<p data-start=\"650\" data-end=\"670\">📋 <strong data-start=\"653\" data-end=\"670\">Specificaties</strong></p>\r\n<ul data-start=\"671\" data-end=\"827\">\r\n<li data-start=\"671\" data-end=\"686\">\r\n<p data-start=\"673\" data-end=\"686\">Merk: Funko</p>\r\n</li>\r\n<li data-start=\"687\" data-end=\"712\">\r\n<p data-start=\"689\" data-end=\"712\">Serie: Thor: Ragnarok</p>\r\n</li>\r\n<li data-start=\"713\" data-end=\"733\">\r\n<p data-start=\"715\" data-end=\"733\">Modelnummer: 244</p>\r\n</li>\r\n<li data-start=\"734\" data-end=\"757\">\r\n<p data-start=\"736\" data-end=\"757\">Personage: Valkyrie</p>\r\n</li>\r\n<li data-start=\"758\" data-end=\"791\">\r\n<p data-start=\"760\" data-end=\"791\">Type: Funko Pop! vinyl figure</p>\r\n</li>\r\n<li data-start=\"792\" data-end=\"827\">\r\n<p data-start=\"794\" data-end=\"827\">Staat: Zo Goed Als Nieuw (ZGAN)</p>\r\n</li>\r\n</ul>\r\n<hr data-start=\"829\" data-end=\"832\">\r\n<p data-start=\"834\" data-end=\"852\">📦 <strong data-start=\"837\" data-end=\"852\">Meegeleverd</strong></p>\r\n<ul data-start=\"853\" data-end=\"898\">\r\n<li data-start=\"853\" data-end=\"898\">\r\n<p data-start=\"855\" data-end=\"898\">Funko Pop! Thor: Ragnarok #244 – Valkyrie</p>\r\n</li>\r\n</ul>\r\n<hr data-start=\"900\" data-end=\"903\">\r\n<p data-start=\"905\" data-end=\"966\" data-is-last-node=\"\" data-is-only-node=\"\">🛡️ <strong data-start=\"909\" data-end=\"927\">Incl. Garantie</strong><br data-start=\"927\" data-end=\"930\">Incl. Garantie: <strong data-start=\"946\" data-end=\"966\" data-is-last-node=\"\">1 maand garantie</strong></p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"border-token-border-light my-2 flex gap-10 border-t pt-4\">\r\n<div class=\"flex items-center justify-center overflow-hidden h-12 w-12 rounded-lg\"> </div>\r\n</div>\r\n<div class=\"z-0 flex min-h-[46px] justify-start\"> </div>",
